{
  "name": "astrobai-red-frontier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"src/shared/store/*.test.mjs\" \"src/features/missions/tests/*.test.mjs\" \"src/features/missions/tests/*.test.ts\"",
    "test:icebound": "node --test \"src/features/missions/tests/icebound*.test.mjs\"",
    "typecheck:icebound": "tsc --ignoreConfig --noEmit --strict --target es2023 --module esnext --moduleResolution bundler --allowImportingTsExtensions --skipLibCheck --types vite/client src/features/missions/engine/icebound/index.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
